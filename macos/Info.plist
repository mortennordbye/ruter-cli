<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!--
    Embedded into the binary's __TEXT,__info_plist section by build.rs.

    Without this, `Bundle.main.bundleIdentifier` is nil and macOS has no stable
    identity to attach a Location Services grant to, so the permission prompt
    never appears and Core Location silently returns nothing. The bundle
    identifier here must stay in sync with the one in scripts/install-macos.sh,
    because that is what the TCC grant is keyed on.
  -->
  <key>CFBundleIdentifier</key>
  <string>no.nordbye.ruter-cli</string>
  <key>CFBundleName</key>
  <string>ruter</string>
  <key>CFBundleExecutable</key>
  <string>ruter</string>
  <key>CFBundlePackageType</key>
  <string>APPL</string>
  <key>CFBundleShortVersionString</key>
  <string>0.1.0</string>
  <key>LSUIElement</key>
  <true/>
  <key>NSLocationWhenInUseUsageDescription</key>
  <string>ruter bruker posisjonen din til å finne avganger fra nærmeste holdeplass.</string>
  <key>NSLocationUsageDescription</key>
  <string>ruter bruker posisjonen din til å finne avganger fra nærmeste holdeplass.</string>
</dict>
</plist>
